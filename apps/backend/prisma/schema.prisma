// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  // Prisma 7's modern generator. The client is written into src/ as ordinary
  // generated source instead of being injected into node_modules, so it
  // survives dependency pruning and multi-stage Docker copies.
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  admin

  @@map("user_role")
}

enum QuackMood {
  happy
  sad
  angry
  silly

  @@map("quack_mood")
}

// Replies are quacks with a parent (one level deep). A quack that is deleted
// while it still has replies stays as a placeholder with no content; see
// docs/adr/0001-replies-as-quacks-with-placeholders.md. CHECK constraints
// (not expressible here) live in the replies migration.
model Quack {
  id        String     @id @default(cuid())
  // null only on a placeholder (deletedAt is set)
  text      String?    @db.Text
  mood      QuackMood?
  // null only on a placeholder
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?
  // set when this quack is a reply
  parent    Quack?     @relation("QuackReplies", fields: [parentId], references: [id], onDelete: Restrict)
  parentId  String?
  replies   Quack[]    @relation("QuackReplies")
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  pollOptions PollOption[]
  pollVotes   PollVote[]

  @@index([userId])
  @@index([parentId, createdAt])
  @@map("quack")
}

// A quack "has a poll" when it has options. Options are immutable after creation.
model PollOption {
  id        String     @id @default(cuid())
  quack     Quack      @relation(fields: [quackId], references: [id], onDelete: Cascade)
  quackId   String
  text      String     @db.VarChar(50)
  // Normalized text (trimmed, whitespace-collapsed, NFC, lowercased) used only to
  // reject duplicate answers. Text, not VarChar(50): lowercasing can lengthen a string.
  textKey   String     @db.Text
  position  Int
  votes     PollVote[]
  createdAt DateTime   @default(now())

  @@unique([quackId, textKey])
  @@unique([quackId, position])
  // Target of the composite foreign key from PollVote.
  @@unique([quackId, id])
  @@map("poll_option")
}

// The primary key is what enforces one vote per user per poll. The composite
// foreign key stops a vote from pointing at another quack's option.
model PollVote {
  quack     Quack      @relation(fields: [quackId], references: [id], onDelete: Cascade)
  quackId   String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  option    PollOption @relation(fields: [quackId, optionId], references: [quackId, id], onDelete: Cascade)
  optionId  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@id([quackId, userId])
  @@index([optionId])
  @@index([userId])
  @@map("poll_vote")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @db.VarChar(255)
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  issuer                String?
  password              String?   @db.Text
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model User {
  id              String    @id
  name            String
  email           String
  emailVerified   Boolean
  image           String?   @db.Text
  createdAt       DateTime
  updatedAt       DateTime
  sessions        Session[]
  accounts        Account[]
  quacks          Quack[]
  pollVotes       PollVote[]
  role            UserRole  @default(user)

  username        String? @db.VarChar(50)
  displayUsername String? @db.VarChar(50)
  bio             String? @db.VarChar(160)
  defaultMood     QuackMood?

  @@unique([email])
  @@unique([username])
  @@map("user")
}
